# OwlPath runs locally. This file is a reference list only: the backend and
# repository scripts DO NOT automatically load a root .env file. Export the
# variables in your shell or inject them with your process manager before
# starting OwlPath.
#
# Provider API keys should normally be entered in the web UI. They are stored
# by the backend's encrypted local secret store and never returned in full;
# do not place real provider keys in this file.

# Consumed by repository start/dev scripts.
OWLPATH_PORT=8000

# Backend storage. OWLPATH_DB_PATH, when set, takes precedence over DATA_DIR.
OWLPATH_DATA_DIR=./data
# OWLPATH_DB_PATH=./data/owlpath.db

# Optional backend controls.
# OWLPATH_MASTER_KEY=<Fernet-key-from-a-secret-manager>
# OWLPATH_CORS_ORIGINS=http://127.0.0.1:5173
# OWLPATH_PROVIDER_TIMEOUT_SECONDS=120
# Research-sandbox DNS proxies that return fake-IP answers (e.g. 198.18.0.0/15).
# Only hostname-resolved provider addresses may fall inside these CIDRs.
# OWLPATH_ALLOW_EGRESS_PROXY_CIDRS=198.18.0.0/15

# Required to authorize governance configuration writes. The caller supplies
# the same value in X-OwlPath-Admin-Token. Replace this example with a long,
# random secret, export it in the server environment, and never commit it.
OWLPATH_GOVERNANCE_ADMIN_TOKEN=replace-with-a-long-random-secret

# Retrospective replay is deliberately disabled in the clinical API. Enable
# only in an approved offline research environment; each request still needs
# the admin token plus a preregistered retrospective_anchor_id.
# OWLPATH_ALLOW_RETROSPECTIVE_RUNS=false
